root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Do not normalise the byte-preserved legacy candidate inputs and outputs.
[reference/legacy-candidates/**]
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = unset
